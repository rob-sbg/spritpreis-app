{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spritpreis-app",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "APP_KV",
      "id": "DEINE_KV_NAMESPACE_ID_HIER"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
